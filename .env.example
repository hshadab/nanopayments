# Circle Gateway (Arc Testnet)
PRIVATE_KEY=0x_your_evm_private_key

# ICME Preflight
ICME_API_KEY=your_icme_api_key
ICME_POLICY_ID=your_compiled_policy_id

# OpenAI (only needed for legacy LangChain demo — npm run demo:legacy)
OPENAI_API_KEY=your_openai_api_key

# Seller config
SELLER_ADDRESS=0x_your_seller_wallet_address
SELLER_PORT=3100

# Verified mode (proof-guard on seller endpoints)
SELLER_REQUIRE_PROOF=true
DEMO_MODE=verified

# Arc Testnet on-chain attestation
#   NanopaymentAttestation.sol is deployed live on Arc Testnet at the address
#   below. Every verified payment writes a real on-chain attestation; receipts
#   are browseable at explorer.testnet.arc.network/address/<address>.
#
#   To redeploy under your own key: `npm run deploy:attestation` and replace
#   the value below. Leave blank to fall back to deterministic simulated
#   receipts (no chain writes) — the demo still runs end-to-end.
ATTESTATION_CONTRACT_ADDRESS=0x76ce30319c561beaa6dcf936017fcbb1e84b18b1
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://explorer.testnet.arc.network
