# Circle Gateway (Arc Testnet)
PRIVATE_KEY=0x_your_evm_private_key

# ICME Preflight
ICME_API_KEY=your_icme_api_key
ICME_POLICY_ID=your_compiled_policy_id

# OpenAI (only needed for legacy LangChain demo — npm run demo:legacy)
OPENAI_API_KEY=your_openai_api_key

# Seller config
SELLER_ADDRESS=0x_your_seller_wallet_address
SELLER_PORT=3100

# Verified mode (proof-guard on seller endpoints)
SELLER_REQUIRE_PROOF=true
DEMO_MODE=verified
